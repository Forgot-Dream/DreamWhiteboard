# Copy to deploy/.env before starting. Never commit deploy/.env.
POSTGRES_DB=dreamwhiteboard
POSTGRES_USER=dreamwhiteboard
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Required only while bootstrapping an empty database; clear both afterward.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=replace-with-a-unique-12+-character-password

APP_BIND=127.0.0.1
APP_PORT=8080

# Keep these local names for source builds, or set versioned/digest-pinned GHCR
# references and start with `docker compose pull && docker compose up -d --no-build`.
API_IMAGE=dreamwhiteboard-api
FRONTEND_IMAGE=dreamwhiteboard-frontend

# Optional Go module proxy used only when building the API image from source.
GOPROXY=https://proxy.golang.org,direct

# Set true only when the public endpoint is HTTPS (recommended for any shared host).
SESSION_COOKIE_SECURE=false
SESSION_TTL=168h

# Same-origin requests need no entry. Add comma-separated development origins only.
ALLOWED_ORIGINS=
MAX_UPLOAD_BYTES=26214400
MAX_IMAGE_PIXELS=40000000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=5m
WS_AUTH_CHECK_INTERVAL=10s

# Keep unreferenced uploads recoverable for seven days by default. Increase this
# if collaborators may reconnect with image edits after a longer interruption.
ASSET_GC_GRACE=168h
ASSET_GC_INTERVAL=10m
ASSET_GC_BATCH_SIZE=100

# Checkpoint-compacted update IDs remain replay-idempotent for 30 days.
BOARD_UPDATE_RECEIPT_RETENTION=720h
BOARD_UPDATE_RECEIPT_CLEANUP_INTERVAL=1h
BOARD_UPDATE_RECEIPT_CLEANUP_BATCH_SIZE=1000
LOG_LEVEL=info
